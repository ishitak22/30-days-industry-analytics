{
  "datasets": [
    {
      "name": "f10e2b23",
      "displayName": "customer_features",
      "config": {
        "version": "1.1",
        "source": "workspace.marketing_campaign.gold_customer_features",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "income_band",
            "expr": "CASE WHEN `income` < 30000 THEN 'Under 30k' WHEN `income` >= 30000 AND `income` < 60000 THEN '30k-59k' WHEN `income` >= 60000 AND `income` < 90000 THEN '60k-89k' ELSE '90k+' END",
            "displayName": "Income Band"
          },
          {
            "name": "spend_band",
            "expr": "CASE WHEN `total_spend` < 500 THEN 'Low Spend (Under $500)' WHEN `total_spend` >= 500 AND `total_spend` < 1500 THEN 'Medium Spend ($500-$1,499)' ELSE 'High Spend ($1,500+)' END",
            "displayName": "Spend Band"
          },
          {
            "name": "response_label",
            "expr": "CASE WHEN `response` = 1 THEN 'Responded' ELSE 'Did not respond' END",
            "displayName": "Response Label"
          },
          {
            "name": "age_band",
            "expr": "CASE WHEN `customer_age` < 30 THEN 'Under 30' WHEN `customer_age` >= 30 AND `customer_age` < 40 THEN '30-39' WHEN `customer_age` >= 40 AND `customer_age` < 50 THEN '40-49' WHEN `customer_age` >= 50 AND `customer_age` < 60 THEN '50-59' ELSE '60+' END",
            "displayName": "Age Band"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "response_rate_pct",
            "expr": "AVG(`response`) * 100",
            "displayName": "Response Rate %",
            "comment": "Campaign response rate as a percentage"
          },
          {
            "name": "avg_customer_spend",
            "expr": "ROUND(AVG(`total_spend`), 0)",
            "displayName": "Avg Customer Spend",
            "comment": "Average customer spend rounded to 0 decimals"
          },
          {
            "name": "previous_campaign_responders",
            "expr": "SUM(`accepted_previous_campaign`)",
            "displayName": "Previous Campaign Responders",
            "comment": "Count of customers who accepted a previous campaign"
          },
          {
            "name": "customer_count",
            "expr": "COUNT(DISTINCT `customer_id`)",
            "displayName": "Customer Count",
            "comment": "Count of distinct customers"
          }
        ]
      }
    },
    {
      "name": "a89a5edc",
      "displayName": "campaign_summary",
      "config": {
        "version": "1.1",
        "source": "workspace.marketing_campaign.gold_campaign_summary",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "customer_segments",
      "displayName": "customer_segments",
      "config": {
        "version": "1.1",
        "source": "WITH base_features AS (\n  SELECT \n    education,\n    marital_status,\n    income,\n    customer_age,\n    total_spend,\n    response,\n    customer_id,\n    CASE WHEN income < 30000 THEN 'Under 30k' \n         WHEN income >= 30000 AND income < 60000 THEN '30k-59k' \n         WHEN income >= 60000 AND income < 90000 THEN '60k-89k' \n         ELSE '90k+' END AS income_band,\n    CASE WHEN customer_age < 30 THEN 'Under 30' \n         WHEN customer_age >= 30 AND customer_age < 40 THEN '30-39' \n         WHEN customer_age >= 40 AND customer_age < 50 THEN '40-49' \n         WHEN customer_age >= 50 AND customer_age < 60 THEN '50-59' \n         ELSE '60+' END AS age_band\n  FROM workspace.marketing_campaign.gold_customer_features\n), segment_stats AS (\n  SELECT \n    education,\n    marital_status,\n    income_band,\n    age_band,\n    COUNT(DISTINCT customer_id) AS customer_count,\n    AVG(response) * 100 AS response_rate_pct,\n    ROUND(AVG(total_spend), 0) AS avg_customer_spend\n  FROM base_features\n  GROUP BY education, marital_status, income_band, age_band\n  HAVING COUNT(DISTINCT customer_id) >= 5\n) SELECT * FROM segment_stats ORDER BY response_rate_pct DESC\n",
        "dimensions": [
          {
            "name": "education",
            "expr": "education"
          },
          {
            "name": "marital_status",
            "expr": "marital_status"
          },
          {
            "name": "income_band",
            "expr": "income_band",
            "displayName": "Income Band"
          },
          {
            "name": "age_band",
            "expr": "age_band",
            "displayName": "Age Band"
          }
        ],
        "measures": [
          {
            "name": "customer_count",
            "expr": "SUM(customer_count)",
            "displayName": "Customer Count"
          },
          {
            "name": "response_rate_pct",
            "expr": "AVG(response_rate_pct)",
            "displayName": "Response Rate %"
          },
          {
            "name": "avg_customer_spend",
            "expr": "AVG(avg_customer_spend)",
            "displayName": "Avg Customer Spend"
          }
        ]
      }
    },
    {
      "name": "customer_signups",
      "displayName": "customer_signups",
      "config": {
        "version": "1.1",
        "source": "workspace.marketing_campaign.silver_marketing_campaign",
        "dimensions": [
          {
            "name": "signup_month",
            "expr": "DATE_TRUNC('MONTH', dt_customer)",
            "displayName": "Signup Month"
          }
        ],
        "measures": [
          {
            "name": "customer_count",
            "expr": "COUNT(DISTINCT id)",
            "displayName": "Customer Count"
          }
        ]
      }
    }
  ],
